{
  "realm": "research-platform",
  "enabled": true,
  "displayName": "Research Platform",
  "sslRequired": "none",
  "registrationAllowed": true,
  "defaultRoles": ["user"],
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard research platform user",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Research platform administrator",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "research-platform-frontend",
      "name": "Research Platform Angular frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "email"]
    }
  ]
}
